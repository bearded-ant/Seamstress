<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+: имена, телефоны и фото клиентов не уходят в облачный бэкап и при переносе. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="file" path="dress_photos/" />
        <exclude domain="file" path="customer_photos/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="file" path="dress_photos/" />
        <exclude domain="file" path="customer_photos/" />
    </device-transfer>
</data-extraction-rules>
